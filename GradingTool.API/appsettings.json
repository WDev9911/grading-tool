{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=GradingToolDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Storage": {
    "BasePath": "Storage",
    "MaxFileSizeMB": 50,
    "AllowedExtensions": [ ".docx" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:*",
      "https://localhost:*"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
